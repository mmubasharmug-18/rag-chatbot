# ── Environment variable template ─────────────────────────────────────────────
# Copy this file to .env and fill in values.
# Never commit your actual .env to Git.

# Optional: HuggingFace token (only needed for gated/private models)
HF_TOKEN=

# Optional: Override number of CPU threads for LLM inference (default: 4)
LLM_N_THREADS=4

# Optional: Number of layers to offload to GPU (0 = CPU only)
# Requires llama-cpp-python built with CUDA/Metal support
LLM_N_GPU_LAYERS=0
